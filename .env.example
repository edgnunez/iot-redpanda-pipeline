# Copy this file to .env and set your own values:
#   Copy-Item .env.example .env
# Set these BEFORE the first `docker compose up`. Passwords are only applied
# when the broker and database are first created; changing them later
# requires `docker compose down -v` (which deletes all data).
REDPANDA_SUPERUSER_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
SENSOR_PASSWORD=change-me
DASHBOARD_PASSWORD=change-me
DB_WRITER_PASSWORD=change-me